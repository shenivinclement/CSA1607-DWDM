<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config
    =======================
    By default Android 9+ blocks all plain HTTP traffic.  This file carves
    out exceptions for the local backend, so the app can reach the
    emotion-analysis / chat server over plain http://.

    All traffic to real internet hosts remains protected (HTTPS only).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Allow plain HTTP to the local dev server only -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Laptop's WiFi address — the phone reaches the backend here -->
        <domain includeSubdomains="false">192.168.1.3</domain>
    </domain-config>
</network-security-config>
